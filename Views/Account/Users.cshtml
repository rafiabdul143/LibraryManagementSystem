 
@model List<LibraryManagement.Web.ViewModels.Account.UserListItemViewModel>
@{
    ViewData["Title"] = "Manage Users";
}

<h2><i class="bi bi-people"></i> Manage Users</h2>

<table class="table table-striped table-hover align-middle mt-3">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.FullName</td>
            <td>@user.Email</td>
            <td>
                @foreach (var role in user.Roles)
                {
                    <span class="badge bg-info text-dark me-1">@role</span>
                }
            </td>
            <td class="text-end">
                <a asp-controller="Account" asp-action="AssignRole" asp-route-userId="@user.UserId"
                   class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil-square"></i> Change Role
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>