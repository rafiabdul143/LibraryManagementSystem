@model LibraryManagement.Web.ViewModels.BorrowHistoryReportViewModel
@using LibraryManagement.Web.Models.Entities
@{
    ViewData["Title"] = "Borrow History Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clock-history"></i> Borrow History</h2>
    <a asp-action="ExportBorrowHistoryCsv" asp-route-memberId="@Model.MemberId" asp-route-bookId="@Model.BookId" class="btn btn-outline-secondary">
        <i class="bi bi-download"></i> Export CSV
    </a>
</div>

<form asp-action="BorrowHistory" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <select name="memberId" class="form-select" asp-items="Model.Members">
            <option value="">All Members</option>
        </select>
    </div>
    <div class="col-md-4">
        <select name="bookId" class="form-select" asp-items="Model.Books">
            <option value="">All Books</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-funnel"></i> Filter</button>
    </div>
    <div class="col-md-2">
        <a asp-action="BorrowHistory" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Book</th>
            <th>Member</th>
            <th>Borrow Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Status</th>
            <th>Fine</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Records.Count == 0)
    {
        <tr><td colspan="7" class="text-center text-muted py-4">No borrow records found.</td></tr>
    }
    @foreach (var r in Model.Records)
    {
        <tr>
            <td>@r.Book.Title</td>
            <td>@r.Member.FullName</td>
            <td>@r.BorrowDate.ToString("dd MMM yyyy")</td>
            <td>@r.DueDate.ToString("dd MMM yyyy")</td>
            <td>@(r.ReturnDate?.ToString("dd MMM yyyy") ?? "-")</td>
            <td>
                @switch (r.Status)
                {
                    case BorrowStatus.Returned:
                        <span class="badge bg-success">Returned</span>
                        break;
                    case BorrowStatus.Overdue:
                        <span class="badge bg-danger">Overdue</span>
                        break;
                    default:
                        <span class="badge bg-primary">Borrowed</span>
                        break;
                }
            </td>
            <td>@(r.FineAmount > 0 ? r.FineAmount.ToString("C") : "-")</td>
        </tr>
    }
    </tbody>
</table>