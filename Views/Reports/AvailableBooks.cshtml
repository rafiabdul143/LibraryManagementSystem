@model LibraryManagement.Web.ViewModels.AvailableBooksReportViewModel
@{
    ViewData["Title"] = "Available Books Report";
}

<h2 class="text-success"><i class="bi bi-journal-check"></i> Available Books</h2>

<form asp-action="AvailableBooks" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control"
               placeholder="Search by title, ISBN, or author..." />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Search</button>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Publisher</th>
            <th>Available Copies</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Books.Count == 0)
    {
        <tr><td colspan="5" class="text-center text-muted py-4">No available books match your search.</td></tr>
    }
    @foreach (var book in Model.Books)
    {
        <tr>
            <td>@book.Title</td>
            <td>@book.Author.FullName</td>
            <td>@book.Category.Name</td>
            <td>@book.Publisher.Name</td>
            <td><span class="badge bg-success">@book.AvailableCopies / @book.TotalCopies</span></td>
        </tr>
    }
    </tbody>
</table>