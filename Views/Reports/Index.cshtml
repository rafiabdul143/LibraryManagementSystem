@{
    ViewData["Title"] = "Reports";
}

<h2 class="mb-4"><i class="bi bi-graph-up"></i> Reports</h2>

<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-clock-history"></i> Borrow History</h5>
                <p class="card-text text-muted">Full log of every checkout, filterable by member or book.</p>
                <a asp-action="BorrowHistory" class="btn btn-primary">View Report</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Overdue Books</h5>
                <p class="card-text text-muted">Books currently past their due date.</p>
                <a asp-action="OverdueBooks" class="btn btn-danger">View Report</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-journal-check"></i> Available Books</h5>
                <p class="card-text text-muted">Books with at least one copy on the shelf right now.</p>
                <a asp-action="AvailableBooks" class="btn btn-success">View Report</a>
            </div>
        </div>
    </div>
</div>