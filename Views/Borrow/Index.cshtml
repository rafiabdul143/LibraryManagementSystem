@model IEnumerable<LibraryManagement.Web.Models.Entities.BorrowRecord>
@{
    ViewData["Title"] = "Borrow / Return";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-arrow-left-right"></i> Active Checkouts</h2>
    <a asp-action="Issue" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Issue Book</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Book</th>
            <th>Member</th>
            <th>Borrow Date</th>
            <th>Due Date</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr><td colspan="6" class="text-center text-muted py-4">No active checkouts.</td></tr>
    }
    @foreach (var record in Model)
    {
        var isOverdue = record.DueDate < DateTime.UtcNow;
        <tr class="@(isOverdue ? "table-danger" : "")">
            <td>@record.Book.Title</td>
            <td>@record.Member.FullName</td>
            <td>@record.BorrowDate.ToString("dd MMM yyyy")</td>
            <td>@record.DueDate.ToString("dd MMM yyyy")</td>
            <td>
                @if (isOverdue)
                {
                    <span class="badge bg-danger">Overdue</span>
                }
                else
                {
                    <span class="badge bg-success">On Time</span>
                }
            </td>
            <td class="text-end">
                <form asp-action="Return" asp-route-borrowRecordId="@record.BorrowRecordId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-primary" onclick="return confirm('Confirm this book has been returned?');">
                        <i class="bi bi-box-arrow-in-left"></i> Return
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>