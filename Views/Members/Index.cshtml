@model IEnumerable<LibraryManagement.Web.Models.Entities.Member>

@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Members</h2>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Member
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Member Since</th>
            <th width="220"></th>
        </tr>
    </thead>

    <tbody>
@foreach (var member in Model)
{
        <tr>
            <td>@member.FullName</td>
            <td>@member.Email</td>
            <td>@member.Phone</td>
            <td>@member.MembershipDate.ToShortDateString()</td>

            <td>
                <a asp-action="Details" asp-route-id="@member.MemberId" class="btn btn-info btn-sm">Details</a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-warning btn-sm">Edit</a>

                    <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-danger btn-sm">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>