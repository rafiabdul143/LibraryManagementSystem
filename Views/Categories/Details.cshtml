@model LibraryManagement.Web.Models.Entities.Category
@{
    ViewData["Title"] = "Category Details";
}

<h2><i class="bi bi-tag"></i> @Model.Name</h2>

<div class="card col-md-8">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.CategoryId" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>