@model LibraryManagement.Web.Models.Entities.Publisher
@{
    ViewData["Title"] = "Delete Publisher";
}

<h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Publisher</h2>
<p class="text-muted">Are you sure you want to delete this publisher? This action cannot be undone.</p>

<div class="card col-md-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.PublisherId" method="post" class="mt-3">
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>