@model List<LibraryManagement.Web.Models.Entities.Publisher>
@{
    ViewData["Title"] = "Publishers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-building"></i> Publishers</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Publisher</a>
    }
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="3" class="text-center text-muted py-4">No publishers found.</td></tr>
    }
    @foreach (var publisher in Model)
    {
        <tr>
            <td>@publisher.Name</td>
            <td>@(string.IsNullOrWhiteSpace(publisher.Address) ? "-" : publisher.Address)</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@publisher.PublisherId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@publisher.PublisherId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@publisher.PublisherId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>