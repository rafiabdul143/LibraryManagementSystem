@model LibraryManagement.Web.Models.Entities.Author
@{
    ViewData["Title"] = "Delete Author";
}

<h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Author</h2>
<p class="text-muted">Are you sure you want to delete this author? This action cannot be undone.</p>

<div class="card col-md-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Full Name</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Bio</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Bio) ? "-" : Model.Bio)</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.AuthorId" method="post" class="mt-3">
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>