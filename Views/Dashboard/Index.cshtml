@model LibraryManagement.Web.ViewModels.DashboardViewModel
@using LibraryManagement.Web.Models.Entities
@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-md-4 col-lg-2-4" style="flex:1 0 20%; max-width:20%;">
        <div class="card text-bg-primary h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.Summary.TotalBooks</div>
                <div>Total Books</div>
            </div>
        </div>
    </div>
    <div class="col-md-4" style="flex:1 0 20%; max-width:20%;">
        <div class="card text-bg-secondary h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.Summary.TotalMembers</div>
                <div>Total Members</div>
            </div>
        </div>
    </div>
    <div class="col-md-4" style="flex:1 0 20%; max-width:20%;">
        <div class="card text-bg-success h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.Summary.AvailableBooks</div>
                <div>Available Books</div>
            </div>
        </div>
    </div>
    <div class="col-md-6" style="flex:1 0 20%; max-width:20%;">
        <div class="card text-bg-info h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.Summary.BorrowedBooks</div>
                <div>Borrowed Books</div>
            </div>
        </div>
    </div>
    <div class="col-md-6" style="flex:1 0 20%; max-width:20%;">
        <div class="card text-bg-danger h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.Summary.OverdueBooks</div>
                <div>Overdue Books</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">Books by Category</div>
            <div class="card-body">
                @if (Model.CategoryDistribution.Count == 0)
                {
                    <p class="text-muted mb-0">No books in the catalog yet.</p>
                }
                else
                {
                    <canvas id="categoryChart" height="220"></canvas>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">Recent Activity</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Borrowed</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.RecentActivity.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">No activity yet.</td></tr>
                    }
                    @foreach (var record in Model.RecentActivity)
                    {
                        <tr>
                            <td>@record.Book.Title</td>
                            <td>@record.Member.FullName</td>
                            <td>@record.BorrowDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @switch (record.Status)
                                {
                                    case BorrowStatus.Returned:
                                        <span class="badge bg-success">Returned</span>
                                        break;
                                    case BorrowStatus.Overdue:
                                        <span class="badge bg-danger">Overdue</span>
                                        break;
                                    default:
                                        <span class="badge bg-primary">Borrowed</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.CategoryDistribution.Count > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
        <script>
            const ctx = document.getElementById('categoryChart');
            new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.CategoryDistribution.Select(c => $"'{c.CategoryName.Replace("'", "\\'")}'")))],
                    datasets: [{
                        data: [@string.Join(",", Model.CategoryDistribution.Select(c => c.BookCount))],
                        backgroundColor: ['#0d6efd','#6c757d','#198754','#0dcaf0','#dc3545','#ffc107','#6610f2','#fd7e14']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        </script>
    }
}