@model LibraryManagement.Web.ViewModels.BookDetailsViewModel
@{
    ViewData["Title"] = "Delete Book";
}

<h2 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Book</h2>
<p class="text-muted">Are you sure you want to delete this book? This action cannot be undone.</p>

<div class="card col-md-6">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">ISBN</dt>
            <dd class="col-sm-8">@Model.ISBN</dd>

            <dt class="col-sm-4">Author</dt>
            <dd class="col-sm-8">@Model.AuthorName</dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@Model.CategoryName</dd>

            <dt class="col-sm-4">Publisher</dt>
            <dd class="col-sm-8">@Model.PublisherName</dd>

            <dt class="col-sm-4">Published Year</dt>
            <dd class="col-sm-8">@Model.PublishedYear</dd>

            <dt class="col-sm-4">Copies</dt>
            <dd class="col-sm-8">@Model.AvailableCopies available / @Model.TotalCopies total</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.BookId" method="post" class="mt-3">
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>